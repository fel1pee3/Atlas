// =============================================================================
// Atlas — schema Prisma (M0–M6). Ver docs/10_Database_Design.md e docs/11_Event_Model.md
// Store primário único no MVP: PostgreSQL + pgvector (ADR-0004 / M6).
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  /// Path fixo (não depende de hoist do monorepo). Importar de `src/generated/prisma`.
  output          = "../src/generated/prisma"
  // native = host do generate; musl = Alpine (Railway/Docker).
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  /// Pooler (Supabase transaction mode :6543) ou Postgres local.
  url       = env("DATABASE_URL")
  /// Sessão direta / session pooler — obrigatório p/ `prisma migrate` no Supabase.
  directUrl = env("DIRECT_URL")
}

/// Usuário = tenant lógico. Todo dado é escopado por userId (docs/09 §9).
model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  events          Event[]
  refreshTokens   RefreshToken[]
  dailyMoods      RmDailyMood[]
  dailyExpenses   RmDailyExpense[]
  dailySleeps     RmDailySleep[]
  dailyActivities RmDailyActivity[]
  dailyPlaces     RmDailyPlaces[]
  dailyCalendars  RmDailyCalendar[]
  insights        Insight[]
  embeddings      Embedding[]

  @@map("users")
}

/// Refresh tokens com rotação (docs/16_Security.md). Guardamos apenas o HASH do token.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// EVENTO — unidade atômica, APPEND-ONLY (Event Sourcing "lite", ADR-0002).
/// Ver docs/11_Event_Model.md. `payload` é JSONB (schema-on-read no banco,
/// validado por Zod na aplicação via @atlas/shared).
model Event {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String
  source     String
  externalId String?  @map("external_id")
  occurredAt DateTime @map("occurred_at")
  ingestedAt DateTime @default(now()) @map("ingested_at")
  payload    Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceLinks InsightEvidence[]

  // Idempotência de ingestão: mesmo (userId, source, externalId) nunca duplica (docs/11 §8).
  @@unique([userId, source, externalId])
  // Query mais comum: timeline por usuário ordenada por tempo do fato (docs/10 §5).
  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  // Sync pull incremental por tempo de ingestão (docs/08 §7.5).
  @@index([userId, ingestedAt])
  @@map("events")
}

/// Read model: humor agregado por dia (docs/10 §8, docs/11 §5.1).
/// Derivado e recomputável a partir de `events` — não é fonte de verdade.
model RmDailyMood {
  userId   String   @map("user_id") @db.Uuid
  day      DateTime @db.Date
  count    Int
  sumScore Int      @map("sum_score")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("rm_daily_mood")
}

/// Read model: gastos agregados por dia (docs/10 §8, docs/11 §5.1).
model RmDailyExpense {
  userId      String   @map("user_id") @db.Uuid
  day         DateTime @db.Date
  count       Int
  totalAmount Decimal  @map("total_amount") @db.Decimal(14, 2)
  currency    String   @default("BRL") @db.VarChar(3)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("rm_daily_expense")
}

/// Read model: sono agregado por dia (M2 — docs/11 §5.1 `rm_daily_sleep`).
model RmDailySleep {
  userId            String   @map("user_id") @db.Uuid
  day               DateTime @db.Date
  count             Int
  totalDurationMin  Int      @map("total_duration_min")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("rm_daily_sleep")
}

/// Read model: atividade agregada por dia (M2 — passos/treinos).
model RmDailyActivity {
  userId       String   @map("user_id") @db.Uuid
  day          DateTime @db.Date
  totalSteps   Int      @map("total_steps")
  workoutCount Int      @default(0) @map("workout_count")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("rm_daily_activity")
}

/// Read model: visitas/lugares por dia (M4 — docs/10 §8, docs/20 M4).
model RmDailyPlaces {
  userId           String   @map("user_id") @db.Uuid
  day              DateTime @db.Date
  visitCount       Int      @map("visit_count")
  totalDurationMin Int      @map("total_duration_min")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("rm_daily_places")
}

/// Read model: agenda por dia (M4 — calendar.event).
model RmDailyCalendar {
  userId           String   @map("user_id") @db.Uuid
  day              DateTime @db.Date
  eventCount       Int      @map("event_count")
  totalDurationMin Int      @map("total_duration_min")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("rm_daily_calendar")
}

/// Insight derivado (docs/10, docs/12 §7). Explicável via insight_evidence.
/// M3: method = rule|stats apenas (sem LLM).
model Insight {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  kind        String
  /// Chave de idempotência da geração (ex.: sleep.short_streak:2026-07-20).
  fingerprint String
  title       String
  body        String
  confidence  Float?
  method      String
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence InsightEvidence[]

  @@unique([userId, fingerprint])
  @@index([userId, status, createdAt])
  @@map("insights")
}

/// Evidências: insight → eventos (docs/11 §7 — explicabilidade inegociável).
model InsightEvidence {
  insightId String  @map("insight_id") @db.Uuid
  eventId   String  @map("event_id") @db.Uuid
  weight    Float?

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([insightId, eventId])
  @@map("insight_evidence")
}

/// Vetores semânticos (M6 — docs/10 §4, docs/14). Coluna `embedding` via SQL cru (pgvector).
model Embedding {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  ownerType   String   @map("owner_type")
  ownerId     String   @map("owner_id") @db.Uuid
  contentHash String   @map("content_hash")
  model       String
  /// pgvector — lido/escrito com $executeRaw / $queryRaw.
  embedding   Unsupported("vector")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId, model])
  @@index([userId, contentHash, model])
  @@map("embeddings")
}

/// Cache global de vetores por hash de conteúdo + modelo (docs/14 §8.2).
model EmbeddingCache {
  contentHash String   @map("content_hash")
  model       String
  embedding   Unsupported("vector")
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([contentHash, model])
  @@map("embedding_cache")
}
