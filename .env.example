# =============================================================================
# Atlas — variáveis de ambiente (EXEMPLO). Copie para `.env` e ajuste.
# NUNCA commite o arquivo `.env` real. Ver docs/16_Security.md e docs/27_DevOps.md
# =============================================================================

# --- Ambiente ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=3333

# --- Banco de dados (docker-compose: serviço "postgres") ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas?schema=public
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
# Porta do Postgres no HOST (mude se a 5432 estiver ocupada; ajuste também a DATABASE_URL).
POSTGRES_PORT=5432

# --- Redis (docker-compose: serviço "redis") — cache + filas BullMQ ---
# Porta no HOST é 6380 (a 6379 costuma estar ocupada por outro Redis local).
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Autenticação JWT (ver docs/16_Security.md) ---
# Gere segredos fortes: `openssl rand -base64 48`
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-em-producao
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- IA (opt-in, fora do caminho crítico no MVP — ver docs/12_AI_Architecture.md) ---
# Deixe vazio no MVP; a inferência usa heurística/estatística por padrão.
LLM_PROVIDER=none
OPENAI_API_KEY=
EMBEDDINGS_MODEL=
